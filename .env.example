# Copy to .env.local. Leave both Supabase values empty to run in single-browser rehearsal mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Address phones use to reach the app (for the QR code), e.g. http://192.168.1.20:3000 on hospital Wi-Fi
# GitHub Pages sets this itself. Empty = the address the presenter opened.
NEXT_PUBLIC_SITE_URL=
